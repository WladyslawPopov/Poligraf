import kotlin.Boolean;

-- Session metadata and state
CREATE TABLE SessionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    timestamp INTEGER NOT NULL,
    title TEXT,
    notes TEXT,
    duration INTEGER NOT NULL DEFAULT 0,
    isCompleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    anomalyCount INTEGER NOT NULL DEFAULT 0
);

-- Time-series clean UI frames for analysis (10 frames per second)
CREATE TABLE SessionFrame (
    sessionId TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    stressScore REAL NOT NULL,
    jitterScore REAL NOT NULL DEFAULT 0.0,
    pitchScore REAL NOT NULL DEFAULT 0.0,
    rmsScore REAL NOT NULL DEFAULT 0.0,
    isAnomaly INTEGER AS Boolean NOT NULL,
    FOREIGN KEY(sessionId) REFERENCES SessionEntity(id) ON DELETE CASCADE
);

-- Raw acoustic metrics for session-long calibration (temporary)
CREATE TABLE CalibrationFrame (
    sessionId TEXT NOT NULL,
    rms REAL NOT NULL,
    pitch REAL NOT NULL,
    jitter REAL NOT NULL,
    FOREIGN KEY(sessionId) REFERENCES SessionEntity(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_calibration_session ON CalibrationFrame(sessionId);
CREATE INDEX IF NOT EXISTS idx_session_frame_session_time ON SessionFrame(sessionId, timestamp);
CREATE INDEX IF NOT EXISTS idx_session_frame_anomaly ON SessionFrame(sessionId, isAnomaly);

-- Notes associated with a specific time in the session
CREATE TABLE SessionNote (
    id TEXT NOT NULL PRIMARY KEY,
    sessionId TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    text TEXT NOT NULL,
    markerColor TEXT,
    markerShape TEXT,
    FOREIGN KEY(sessionId) REFERENCES SessionEntity(id) ON DELETE CASCADE
);

-- Session Queries
insertSession:
INSERT OR REPLACE INTO SessionEntity(id, timestamp, title, notes, duration, isCompleted, anomalyCount)
VALUES (?, ?, ?, ?, ?, ?, ?);

getAllSessions:
SELECT s.id,
       s.timestamp,
       s.title,
       s.notes,
       s.duration,
       s.isCompleted,
       s.anomalyCount AS anomalyCount,
       (SELECT COUNT(*) FROM SessionNote n WHERE n.sessionId = s.id) AS noteCount
FROM SessionEntity s
WHERE s.isCompleted = 1
ORDER BY s.timestamp DESC;

getSessionById:
SELECT * FROM SessionEntity WHERE id = ?;

deleteSessionById:
DELETE FROM SessionEntity WHERE id = ?;

updateSessionDuration:
UPDATE SessionEntity SET duration = ? WHERE id = ?;

finalizeSession:
UPDATE SessionEntity SET duration = ?, anomalyCount = ?, isCompleted = 1 WHERE id = ?;

updateSessionMetadata:
UPDATE SessionEntity SET title = ?, notes = ? WHERE id = ?;

clearSessions:
DELETE FROM SessionEntity;

countSessions:
SELECT COUNT(*) FROM SessionEntity;

-- Frame Queries
insertFrame:
INSERT INTO SessionFrame(sessionId, timestamp, stressScore, jitterScore, pitchScore, rmsScore, isAnomaly)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertCalibrationFrame:
INSERT INTO CalibrationFrame(sessionId, rms, pitch, jitter)
VALUES (?, ?, ?, ?);

getCalibrationData:
SELECT rms, pitch, jitter FROM CalibrationFrame WHERE sessionId = ?;

deleteCalibrationData:
DELETE FROM CalibrationFrame WHERE sessionId = ?;

getFramesBySessionId:
SELECT * FROM SessionFrame WHERE sessionId = ? ORDER BY timestamp ASC;

deleteFramesBySessionId:
DELETE FROM SessionFrame WHERE sessionId = ?;

countAnomaliesBySessionId:
SELECT COUNT(*) FROM SessionFrame WHERE sessionId = ? AND isAnomaly = 1;

getUncompletedSession:
SELECT * FROM SessionEntity WHERE isCompleted = 0 LIMIT 1;

deleteUncompletedSessions:
DELETE FROM SessionEntity WHERE isCompleted = 0;

-- Note Queries
insertNote:
INSERT OR REPLACE INTO SessionNote(id, sessionId, timestamp, text, markerColor, markerShape)
VALUES (?, ?, ?, ?, ?, ?);

getNotesBySessionId:
SELECT * FROM SessionNote WHERE sessionId = ? ORDER BY timestamp ASC;

deleteNoteById:
DELETE FROM SessionNote WHERE id = ?;
