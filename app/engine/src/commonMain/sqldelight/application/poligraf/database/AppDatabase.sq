import kotlin.Boolean;

-- Session metadata and state
CREATE TABLE SessionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    timestamp INTEGER NOT NULL,
    title TEXT,
    notes TEXT,
    duration INTEGER NOT NULL DEFAULT 0,
    isCompleted INTEGER AS Boolean NOT NULL DEFAULT 0
);

-- Time-series data for analysis (10 frames per second)
CREATE TABLE SessionFrame (
    sessionId TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    rms REAL NOT NULL,
    pitch REAL NOT NULL,
    jitter REAL NOT NULL,
    stressScore REAL NOT NULL,
    isAnomaly INTEGER AS Boolean NOT NULL,
    isCalibrated INTEGER AS Boolean NOT NULL DEFAULT 1,
    FOREIGN KEY(sessionId) REFERENCES SessionEntity(id) ON DELETE CASCADE
);

-- Session Queries
insertSession:
INSERT OR REPLACE INTO SessionEntity(id, timestamp, title, notes, duration, isCompleted)
VALUES (?, ?, ?, ?, ?, ?);

getAllSessions:
SELECT * FROM SessionEntity WHERE isCompleted = 1 ORDER BY timestamp DESC;

getSessionById:
SELECT * FROM SessionEntity WHERE id = ?;

deleteSessionById:
DELETE FROM SessionEntity WHERE id = ?;

updateSessionDuration:
UPDATE SessionEntity SET duration = ? WHERE id = ?;

clearSessions:
DELETE FROM SessionEntity;

-- Frame Queries
insertFrame:
INSERT INTO SessionFrame(sessionId, timestamp, rms, pitch, jitter, stressScore, isAnomaly, isCalibrated)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getFramesBySessionId:
SELECT * FROM SessionFrame WHERE sessionId = ? ORDER BY timestamp ASC;

deleteFramesBySessionId:
DELETE FROM SessionFrame WHERE sessionId = ?;

getUncompletedSession:
SELECT * FROM SessionEntity WHERE isCompleted = 0 LIMIT 1;

deleteUncompletedSessions:
DELETE FROM SessionEntity WHERE isCompleted = 0;
